# Local Gemini authentication. Never commit real secrets.
GEMINI_API_KEY=

# Google Cloud deployment / Firestore configuration.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# memory | firestore
INTENTGUARD_STORAGE=memory

# Hackathon-required model floor; default implementation target.
INTENTGUARD_MODEL=gemini-3.5-flash
