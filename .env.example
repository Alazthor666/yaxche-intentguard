# Local Gemini authentication. Never commit real secrets.
GEMINI_API_KEY=

# Google Cloud deployment / Firestore configuration.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# memory | firestore
INTENTGUARD_STORAGE=memory

# Hackathon requires Gemini 3.5 or newer. Current project default follows the
# current Google Agents CLI examples and targets Gemini 3.7 Flash.
INTENTGUARD_MODEL=gemini-3.7-flash
